# URL pública do site (canonical, Open Graph, sitemap). Na Vercel, se não definires,
# é usado automaticamente VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# --- Opcional: envio de pedidos de catering por email (rota /api/encomenda) ---
# Sem estas três variáveis a rota responde 501 e o site continua a usar só o WhatsApp.
# Serviço usado: Resend (https://resend.com). O domínio do remetente tem de estar verificado.
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=
