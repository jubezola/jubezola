# Copia para .env (local) ou define na Vercel (Project → Settings → Environment Variables). Nunca faças commit do .env.
# Postgres próprio desta cópia (ex.: Neon ou Supabase, plano gratuito). Nunca a BD do LeadRadar original.
DATABASE_URL=postgres://utilizador:senha@host/bd?sslmode=require
PORT=4317
# Pôr a 1 atrás de HTTPS (na Vercel é automático).
COOKIE_SECURE=0
# Opcional: servidor Overpass alternativo.
# OVERPASS_URL=
